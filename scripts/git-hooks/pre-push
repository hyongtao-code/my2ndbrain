#!/usr/bin/env bash
# Block pushes to main / master on this repo (per project convention:
# development happens on the `dev` branch; main is the stable release).
#
# Override to push to main anyway by setting GIT_ALLOW_MAIN_PUSH=1 in env.
#
# Install:
#   ln -s ../../scripts/git-hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push

set -euo pipefail

ALLOW="${GIT_ALLOW_MAIN_PUSH:-0}"

while read -r local_sha remote_sha refname; do
    case "$refname" in
        refs/heads/main|refs/heads/master)
            if [[ "$ALLOW" != "1" ]]; then
                echo "ERROR: pushing to '$refname' is blocked on this repo." >&2
                echo "       Development happens on the 'dev' branch." >&2
                echo "       Switch:   git checkout dev" >&2
                echo "       Override: GIT_ALLOW_MAIN_PUSH=1 git push ..." >&2
                exit 1
            fi
            ;;
    esac
done

exit 0