# MySecondBrain configuration.
# Copy to `.env` and edit. The backend (Pydantic Settings) reads these.

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=my2ndbrain
DB_PASSWORD=change-me
DB_NAME=my2ndbrain

# --- Embedding model ---
# Default: sentence-transformers/all-MiniLM-L6-v2 (384-dim, ~90MB, English-leaning).
# Will auto-fallback to an offline TF-IDF model if the package isn't installed.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DEVICE=cpu

# --- LLM provider ---
# heuristic (default, offline) | openai | ollama
LLM_PROVIDER=Minimax
LLM_MODEL=Minimax-M3
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Auto-link threshold (cosine similarity, 0..1) ---
AUTO_EDGE_THRESHOLD=0.55
TOP_K_NEIGHBORS=6